// EduVerse AI — database schema (Phase 1)
// Tables for later phases (missions, achievements, leaderboards, social,
// notifications, subscriptions, payments) are added by their own migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ContentSource {
  HUMAN
  AI_GENERATED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_BLANK
  MATCHING
  WORD_ORDER
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum XpSource {
  LESSON_COMPLETION
  LESSON_PRACTICE
  ADMIN_ADJUSTMENT
}

enum AiRole {
  SYSTEM
  USER
  ASSISTANT
}

// ---------- Identity & access ----------

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String     @map("password_hash")
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  profile        Profile?
  roles          UserRole[]
  refreshTokens  RefreshToken[]
  oneTimeTokens  OneTimeToken[]
  enrollments    CourseEnrollment[]
  lessonProgress LessonProgress[]
  attempts       LessonAttempt[]
  xpTransactions XpTransaction[]
  streak         Streak?
  learningPlans  LearningPlan[]
  aiSessions     AiSession[]
  auditLogs      AuditLog[]

  @@map("users")
}

model Profile {
  userId              String    @id @map("user_id")
  displayName         String    @map("display_name")
  avatarUrl           String?   @map("avatar_url")
  locale              String    @default("tr")
  timezone            String    @default("Europe/Istanbul")
  dailyGoalXp         Int       @default(20) @map("daily_goal_xp")
  learningGoal        String?   @map("learning_goal")
  selfAssessedLevel   CourseLevel? @map("self_assessed_level")
  interests           String[]  @default([])
  onboardingCompleted Boolean   @default(false) @map("onboarding_completed")
  totalXp             Int       @default(0) @map("total_xp")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Role {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  createdAt   DateTime         @default(now()) @map("created_at")
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  familyId     String    @map("family_id")
  tokenHash    String    @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model OneTimeToken {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  purpose    TokenPurpose
  tokenHash  String       @unique @map("token_hash")
  expiresAt  DateTime     @map("expires_at")
  consumedAt DateTime?    @map("consumed_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("one_time_tokens")
}

// ---------- Catalog ----------

model Category {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  icon      String
  color     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  courses   Course[]

  @@map("categories")
}

model Course {
  id          String        @id @default(uuid())
  slug        String        @unique
  categoryId  String        @map("category_id")
  title       String
  description String
  level       CourseLevel
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  category    Category           @relation(fields: [categoryId], references: [id])
  units       Unit[]
  enrollments CourseEnrollment[]

  @@index([categoryId, status])
  @@map("courses")
}

model Unit {
  id        String   @id @default(uuid())
  courseId  String   @map("course_id")
  title     String
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, sortOrder])
  @@map("units")
}

model Lesson {
  id          String        @id @default(uuid())
  slug        String        @unique
  unitId      String        @map("unit_id")
  title       String
  explanation String
  examples    String[]      @default([])
  xpReward    Int           @map("xp_reward")
  sortOrder   Int           @map("sort_order")
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  unit      Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  questions Question[]
  progress  LessonProgress[]
  attempts  LessonAttempt[]

  @@unique([unitId, sortOrder])
  @@map("lessons")
}

model Question {
  id          String        @id @default(uuid())
  lessonId    String        @map("lesson_id")
  type        QuestionType
  prompt      String
  payload     Json
  answerKey   Json          @map("answer_key")
  explanation String
  sortOrder   Int           @map("sort_order")
  source      ContentSource @default(HUMAN)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")

  lesson  Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answers QuestionAnswer[]

  @@unique([lessonId, sortOrder])
  @@map("questions")
}

// ---------- Learning ----------

model CourseEnrollment {
  userId         String    @map("user_id")
  courseId       String    @map("course_id")
  enrolledAt     DateTime  @default(now()) @map("enrolled_at")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  completedAt    DateTime? @map("completed_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
  @@index([userId, lastActivityAt])
  @@map("course_enrollments")
}

model LessonProgress {
  userId        String   @map("user_id")
  lessonId      String   @map("lesson_id")
  timesCompleted Int     @default(0) @map("times_completed")
  bestAccuracy  Int      @default(0) @map("best_accuracy")
  firstCompletedAt DateTime @default(now()) @map("first_completed_at")
  lastCompletedAt  DateTime @default(now()) @map("last_completed_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@map("lesson_progress")
}

model LessonAttempt {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  lessonId    String        @map("lesson_id")
  status      AttemptStatus @default(IN_PROGRESS)
  correctCount Int          @default(0) @map("correct_count")
  totalCount  Int           @default(0) @map("total_count")
  xpAwarded   Int           @default(0) @map("xp_awarded")
  startedAt   DateTime      @default(now()) @map("started_at")
  completedAt DateTime?     @map("completed_at")

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson  Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answers QuestionAnswer[]

  @@index([userId, startedAt])
  @@map("lesson_attempts")
}

model QuestionAnswer {
  id         String   @id @default(uuid())
  attemptId  String   @map("attempt_id")
  questionId String   @map("question_id")
  response   Json
  isCorrect  Boolean  @map("is_correct")
  answeredAt DateTime @default(now()) @map("answered_at")

  attempt  LessonAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("question_answers")
}

model LearningPlan {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  goal               String
  dailyGoalXp        Int      @map("daily_goal_xp")
  recommendedCourses String[] @default([]) @map("recommended_courses")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("learning_plans")
}

// ---------- Gamification ----------

model XpTransaction {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  amount     Int
  source     XpSource
  sourceId   String   @map("source_id")
  localDate  DateTime @map("local_date") @db.Date
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, sourceId])
  @@index([userId, localDate])
  @@map("xp_transactions")
}

model Streak {
  userId         String    @id @map("user_id")
  currentCount   Int       @default(0) @map("current_count")
  longestCount   Int       @default(0) @map("longest_count")
  lastActiveDate DateTime? @map("last_active_date") @db.Date
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

// ---------- AI (Phase 4 uses these) ----------

model AiSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  provider  String
  topic     String?
  createdAt DateTime @default(now()) @map("created_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId, createdAt])
  @@map("ai_sessions")
}

model AiMessage {
  id           String   @id @default(uuid())
  sessionId    String   @map("session_id")
  role         AiRole
  content      String
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  createdAt    DateTime @default(now()) @map("created_at")

  session AiSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("ai_messages")
}

// ---------- Audit ----------

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
