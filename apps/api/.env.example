NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://eduverse:eduverse@localhost:5432/eduverse?schema=public
DATABASE_URL_UNPOOLED=postgresql://eduverse:eduverse@localhost:5432/eduverse?schema=public
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGINS=http://localhost:5173

# AI providers (Phase 4). Keys live only on the server.
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Mail: "console" logs links in development. Production needs a real transport.
MAIL_TRANSPORT=console
APP_PUBLIC_URL=http://localhost:3000
